# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://admin:password@cluster0.abcde.mongodb.net/mycollege_db?retryWrites=true&w=majority"

# SMTP EMAIL CONFIGURATION (for real email delivery of credentials and notices):
# For Gmail / Google Workspace: SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_SECURE="true", and use a 16-digit App Password in SMTP_PASS
# SMTP_USER is the primary authenticated account (e.g., corporativo@mycollege.com.mx)
# SMTP_FROM is the alias address shown to recipients (e.g., notifications@mycollege.com.mx)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="corporativo@mycollege.com.mx"
SMTP_PASS="YOUR_16_CHARACTER_APP_PASSWORD"
SMTP_FROM="notifications@mycollege.com.mx"


